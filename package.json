{
  "name": "vuon-mua-vui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run progression:docs && node scripts/build.mjs",
    "check:progression": "node scripts/progression.mjs",
    "check:assets": "node scripts/audit-assets.mjs",
    "gameplay:docs": "node scripts/gameplay-docs.mjs",
    "check:gameplay-docs": "node scripts/gameplay-docs.mjs --check",
    "progression:docs": "node scripts/progression.mjs --write-docs",
    "pixel:progression-art": "py scripts/normalize-progression-crops-v4.py",
    "pixel:livestock-art": "py scripts/normalize-progression-livestock-v2.py",
    "pixel:additional-livestock-art": "py scripts/normalize-additional-livestock-v1.py",
    "pixel:farmer-actions": "py scripts/generate-farmer-action-atlases.py",
    "test": "node --test",
    "test:scale": "node scripts/scale-load.mjs",
    "d1:create": "npx wrangler d1 create vuon-mua-vui",
    "d1:migrate": "npx wrangler d1 migrations apply DB --remote",
    "deploy:worker": "npx wrangler deploy",
    "check:size": "node scripts/workspace-size.mjs"
  }
}
